# Porta em que o servidor vai rodar
PORT=3000

# Banco de dados (Turso). Em desenvolvimento local, deixe essas duas linhas
# em branco/comentadas que ele cria um arquivo local sozinho. Em produção
# (Render, etc.), preencha com os dados do seu banco criado em turso.tech —
# necessário porque o disco do Render free tier não é permanente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Credenciais da sua instância Z-API (painel Z-API > Instâncias)
ZAPI_INSTANCE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
ZAPI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# Token de Segurança da conta (painel Z-API > Segurança) — opcional, mas recomendado
ZAPI_CLIENT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Nome do salão, usado no texto do lembrete
SALON_NAME=AgendaUnhas

# Endereço do frontend, usado para liberar CORS (o navegador só aceita chamadas
# de um domínio autorizado). Troque pelo link real depois que publicar o frontend.
FRONTEND_URL=http://localhost:5173
